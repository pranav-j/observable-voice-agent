# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Values below are local-dev defaults only.

# --- Postgres (docker compose) ---
POSTGRES_USER=voice
POSTGRES_PASSWORD=voice
POSTGRES_DB=voice_order
POSTGRES_PORT=5432
DATABASE_URL=postgresql://voice:voice@localhost:5432/voice_order

# --- LiveKit (local server in dev mode) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Phoenix (OpenTelemetry collector + UI) ---
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
