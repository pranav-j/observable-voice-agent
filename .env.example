# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Values below are local-dev defaults only.

# --- Postgres (docker compose) ---
POSTGRES_USER=voice
POSTGRES_PASSWORD=voice
POSTGRES_DB=voice_order
POSTGRES_PORT=5432
DATABASE_URL=postgresql://voice:voice@localhost:5432/voice_order

# --- LiveKit (local server in dev mode) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Phoenix (OpenTelemetry collector + UI) ---
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# --- LLM (OpenAI) ---
# Secret: put your real key in .env only. Tests that need it skip when it's empty.
OPENAI_API_KEY=
# Model for the order-taking agent.
LLM_MODEL=gpt-6-luna
# Model that plays the simulated caller in evals. Its cost is tracked separately.
CALLER_LLM_MODEL=gpt-6-luna

# --- Voice pipeline (see docs/adr/0004-voice-pipeline.md) ---
# Name the worker registers under; the backend's tokens dispatch this agent.
AGENT_NAME=order-agent
STT_MODEL=gpt-live-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral
# Audio format from text-to-speech: mp3 or pcm (raw audio, no decoding before playback).
TTS_FORMAT=mp3
# Local speech instead of OpenAI's (docs/adr/0007-local-speech.md): STT_PROVIDER=whisper
# and TTS_PROVIDER=kokoro. Run make models first.
STT_PROVIDER=openai
WHISPER_MODEL=small.en
TTS_PROVIDER=openai
KOKORO_VOICE=af_heart
MODELS_DIR=models
# Silence (ms) before the turn detector may decide the caller has finished.
EOU_SILENCE_MS=500
# Start generating a reply before the turn is confirmed over (true/false). Off by
# default: with it on, the agent sometimes said the same sentence twice.
ENABLE_PREEMPTIVE_GENERATION=false
# Say a short filler when a tool call takes longer than FILLER_AFTER_MS.
ENABLE_FILLER_PHRASES=false
FILLER_AFTER_MS=1200
# Hard cap on call length, and how long a silent caller is kept on the line.
MAX_CALL_SECONDS=300
IDLE_TIMEOUT_SECONDS=30
# Where per-session audio, transcripts, tool calls and events are written (gitignored).
RECORDINGS_DIR=recordings

# Harness validation only: break one thing in the voice worker on purpose
# (none, no_barge_in, drop_modifiers, aggressive_eou, slow_llm).
FAULT=none
